---
layout: layouts/base.njk
---
<article class="work-item">
  <header class="page-header">
    <div class="eyebrow">
      <a href="/work/">← Back to Work</a>
    </div>
    <h1>{{ title }}</h1>
    {% if summary %}<p class="subtitle">{{ summary }}</p>{% endif %}
    {% if date %}<div class="meta">{{ date | date }}</div>{% endif %}
  </header>

  {% if image %}
  <div class="work-hero">
    <img src="{{ image }}" alt="{{ title }}">
  </div>
  {% endif %}

  <div class="prose">
    {{ content | safe }}
  </div>

  {% if file %}
  <div class="download">
    <a class="button" href="{{ file }}">Download PDF</a>
  </div>
  {% endif %}
</article>
