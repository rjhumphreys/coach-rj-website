<footer class="site-footer">
  <div class="wrap footer-wrap">
    <div class="footer-tagline">{{ site.values }}</div>
    <div class="footer-links">
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      <a href="{{ site.socials.instagram.url }}" target="_blank" rel="noopener">Instagram {{ site.socials.instagram.handle }}</a>
    </div>
    <div class="footer-copy">© {{ currentYear }} {{ site.fullName }}</div>
  </div>
</footer>
